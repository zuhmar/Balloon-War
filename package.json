{
  "name": "water-balloon-war",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wbw/web -- --host 0.0.0.0",
    "build": "npm run typecheck && npm run build -w @wbw/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "vitest": "^3.2.4",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.2",
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0"
  }
}
